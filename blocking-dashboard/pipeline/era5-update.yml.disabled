# REVIEW TEMPLATE ONLY. This file is outside .github/workflows and cannot run.
# After author validation, merge/rebase the dashboard as desired, copy this file
# to .github/workflows/era5-update.yml and configure the encrypted CDSAPI_KEY
# secret. This workflow refreshes DATA ONLY and never deploys GitHub Pages.
name: Update ERA5 blocking archive
on:
  workflow_dispatch:
  schedule:
    - cron: '35 15 * * *'
permissions:
  contents: write
concurrency:
  group: era5-blocking-update
  cancel-in-progress: false
jobs:
  update:
    if: github.repository == 'prasadshelke19/prasadshelke19.github.io'
    runs-on: ubuntu-latest
    timeout-minutes: 180
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: python -m pip install -r blocking-dashboard/pipeline/requirements.txt
      - uses: actions/cache/restore@v4
        with:
          path: working-data/era5
          key: era5-z500-2p5-${{ github.run_id }}
          restore-keys: era5-z500-2p5-
      - name: Require pre-seeded historical cache
        run: |
          test -f working-data/era5/era5-z500-1980-01.nc || {
            echo 'Bootstrap the historical archive first; see blocking-dashboard/README.md.'
            exit 1
          }
      - name: Refresh recent ERA5T and finalized observations
        env:
          CDSAPI_KEY: ${{ secrets.CDSAPI_KEY }}
        run: python blocking-dashboard/pipeline/download_era5.py --start-year 1980 --grid 2.5 --refresh-days 100
      - run: python -m pytest blocking-dashboard/tests -q
      - run: node --test blocking-dashboard/tests/core.test.cjs
      - run: python blocking-dashboard/pipeline/build_data.py --reference-start 1980 --reference-end 2014
      - uses: actions/cache/save@v4
        with:
          path: working-data/era5
          key: era5-z500-2p5-${{ github.run_id }}
      - name: Commit verified data on the workflow branch
        run: |
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          git add blocking-dashboard/data/era5.js
          if git diff --cached --quiet; then exit 0; fi
          git commit -m 'Update verified ERA5 blocking archive'
          git push
